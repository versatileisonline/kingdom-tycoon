--!strict
local Tests = {}
function Tests.Run(Input: any): ()
	local s = Input.New()
	Input.Press(s, 0)
	assert(s.Requested and not s.Locked, "Hold must request temporary sprint")
	Input.Release(s, 0.1)
	assert(not s.Requested, "Release must stop temporary sprint")
	Input.Press(s, 0.2)
	Input.Release(s, 0.25)
	assert(s.Requested and s.Locked, "Double-tap must survive Shift release")
	Input.Step(s, 0.1, false)
	assert(s.Locked, "Brief direction change cancelled lock")
	Input.Step(s, 0.1, true)
	Input.Step(s, 0.1, false)
	assert(s.Locked, "Movement did not reset stopping grace")
	Input.Step(s, 0.06, false)
	assert(not s.Requested and not s.Locked, "Stopping must cancel lock")

	Input.Press(s, 1)
	Input.Release(s, 1.05)
	Input.Press(s, 1.2)
	Input.Release(s, 1.25)
	Input.Step(s, 5, true)
	assert(s.Locked, "Moving or jumping must preserve lock")
	Input.Press(s, 2)
	assert(not s.Requested and not s.Locked, "Shift must cancel existing lock")
	Input.Release(s, 2.05)
	Input.Press(s, 2.1)
	assert(not s.Locked, "Cancel tap must not seed another double-tap")
	Input.Cancel(s)
	assert(not s.Requested and not s.Pressed, "Blocking/exhaustion must clear input")
	Input.Step(s, 10, true)
	assert(not s.Requested, "Recovery must not restart sprint")
	Input.Press(s, 3)
	assert(s.Requested and not s.Locked, "Fresh press must rearm after exhaustion")
	Input.Cancel(s)

	Input.Press(s, 4)
	Input.Release(s, 4.05)
	Input.Press(s, 4.4)
	assert(s.Requested and not s.Locked, "Slow taps must remain temporary")
	Input.Release(s, 5)
	Input.Press(s, 5.05)
	assert(not s.Locked, "A long hold must not count as first tap")
	Input.Cancel(s)
	Input.Press(s, 6)
	Input.Release(s, 6.05)
	Input.Cancel(s)
	Input.Press(s, 6.2)
	assert(not s.Locked, "Menu/death/revocation must clear pending double-tap")
	print("All sprint input checks passed")
end
return Tests
