--!strict
local Tests = {}
function Tests.Run(Registry: any): ()
	local state = Registry.new()
	local other = Registry.new()
	assert(state.Get("CollectNow") == "Loading", "ownership state mismatch")
	local first = state.Begin("CollectNow")
	local second = state.Begin("CollectNow")
	assert(not state.Complete("CollectNow", first, true), "stale lookup must not grant")
	assert(state.Complete("CollectNow", second, nil))
	assert(state.Get("CollectNow") == "Unavailable" and not state.Owns("CollectNow"), "ownership state mismatch")
	local third = state.Begin("CollectNow")
	assert(state.Complete("CollectNow", third, false))
	assert(state.Get("CollectNow") == "Unowned", "ownership state mismatch")
	local fourth = state.Begin("CollectNow")
	assert(state.Complete("CollectNow", fourth, true))
	assert(state.Owns("CollectNow") and not state.Owns("AutoCollect"), "ownership state mismatch")
	assert(not other.Owns("CollectNow"), "registries do not share ownership")
	other.Destroy()
	local refresh = state.Begin("CollectNow")
	assert(state.Owns("CollectNow"), "confirmed ownership survives temporary refresh")
	state.Complete("CollectNow", refresh, nil)
	assert(state.Owns("CollectNow"), "network failure must not revoke confirmed ownership")
	state.SetPreview("CollectNow", false)
	assert(not state.Owns("CollectNow"), "ownership state mismatch")
	assert(not state.Complete("CollectNow", fourth, true), "preview reset invalidates requests")
	state.Destroy()
	assert(not state.Complete("CollectNow", state.Begin("CollectNow"), true), "ownership state mismatch")
	print("[KingdomTycoon][ShopTests] All shop ownership checks passed")
end
return Tests
